{
  "expo": {
    "name": "Acemia",
    "slug": "meet-me",
    "version": "8.0.1",
    "orientation": "portrait",
    "icon": "./assets/AcemiaLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/AcemiaLogo.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deve",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Acemia a besoin d'accéder à votre caméra pour prendre des photos.",
        "NSMicrophoneUsageDescription": "Acemia a besoin d'accéder à votre micro pour envoyer des messages vocaux.",
        "NSContactsUsageDescription": "Acemia a besoin d'accéder à vos contacts pour synchroniser vos amis.",
        "NSPhotoLibraryUsageDescription": "Acemia a besoin d'accéder à votre bibliothèque photo pour partager des images.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.deve",
      "googleServicesFile": "./google-services.json",
      "versionCode": 109,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AcemiaLogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "READ_CONTACTS",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Acemia utilise votre position uniquement lorsque vous activez le partage et que l’application est ouverte."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "newArchEnabled": false,
            "jsEngine": "hermes",
            "kotlinVersion": "1.9.25",
            "gradleWrapperVersion": "8.8",
            "enable16KBPageSize": true,
            "extraMavenRepos": [
              "https://storage.googleapis.com/r8-releases/raw/master/com/android/tools/r8/8.3.37/r8-8.3.37.jar"
            ]
          }
        }
      ],
      "expo-font",
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "color": "#673AB7",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://meet-me-backend-sg5c.onrender.com/api",
      "socketUrl": "https://meet-me-backend-sg5c.onrender.com",
      "googleWebClientId": "586234416344-41rf1rrjpqk67tmjv6q4epecfsojp4fe.apps.googleusercontent.com",
      "eas": {
        "projectId": "756b143f-e1ce-4d7d-870c-1aa4ead509cb"
      }
    },
    "owner": "imagess-team"
  }
}
