{
  "expo": {
    "name": "Meet Me",
    "slug": "meet-me",
    "version": "93.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo.png",
      "backgroundColor": "#673AB7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deve",
      "infoPlist": {
        "NSCameraUsageDescription": "Meet a besoin d'accéder à votre caméra pour prendre des photos.",
        "NSMicrophoneUsageDescription": "Meet a besoin d'accéder à votre micro pour envoyer des messages vocaux.",
        "NSContactsUsageDescription": "Meet a besoin d'accéder à vos contacts pour synchroniser vos amis.",
        "NSPhotoLibraryUsageDescription": "Meet a besoin d'accéder à votre bibliothèque photo pour partager des images.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "requiresFullScreen": true,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.deve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "READ_CONTACTS",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "newArchEnabled": false,
            "jsEngine": "hermes",
            "kotlinVersion": "1.9.25",
            "gradleWrapperVersion": "8.8"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://meet-me-backend-sg5c.onrender.com/api",
      "socketUrl": "https://meet-me-backend-sg5c.onrender.com",
      "eas": {
        "projectId": "756b143f-e1ce-4d7d-870c-1aa4ead509cb"
      }
    },
    "owner": "imagess-team"
  }
}
