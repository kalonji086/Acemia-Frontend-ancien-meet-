{
  "expo": {
    "name": "Meet",
    "slug": "meet-app",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo.png",
      "backgroundColor": "#673AB7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meet.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Meet a besoin d'accéder à votre caméra pour les appels vidéo.",
        "NSMicrophoneUsageDescription": "Meet a besoin d'accéder à votre micro pour les appels audio et vidéo."
      }
    },
    "android": {
      "package": "com.deve",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "READ_PHONE_STATE",
        "BLUETOOTH_CONNECT"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "newArchEnabled": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://meet-me-backend-sg5c.onrender.com/api",
      "socketUrl": "https://meet-me-backend-sg5c.onrender.com",
      "eas": {
        "projectId": "822dba2a-c0bc-41fd-9d5b-fcf8c9303291"
      }
    },
    "owner": "docteurparlemois-team"
  }
}
