# Configuration de l'application Acemia

# URLs API
API_BASE_URL=http://localhost:3000/api
SOCKET_URL=http://localhost:3000

# Clés API de traduction
GOOGLE_TRANSLATE_API_KEY=votre_cle_google_translate_ici
DEEPL_API_KEY=votre_cle_deepl_ici

# Configuration Firebase (pour les notifications)
FIREBASE_API_KEY=votre_cle_firebase_ici
FIREBASE_AUTH_DOMAIN=votre_domaine_firebase_ici
FIREBASE_PROJECT_ID=votre_project_id_firebase_ici
FIREBASE_STORAGE_BUCKET=votre_bucket_firebase_ici
FIREBASE_MESSAGING_SENDER_ID=votre_sender_id_firebase_ici
FIREBASE_APP_ID=votre_app_id_firebase_ici

# Configuration AWS (pour le stockage)
AWS_ACCESS_KEY_ID=votre_access_key_aws_ici
AWS_SECRET_ACCESS_KEY=votre_secret_key_aws_ici
AWS_REGION=eu-west-3
AWS_S3_BUCKET=votre_bucket_s3_ici

# Configuration de l'application
APP_NAME=Acemia
APP_VERSION=1.0.0
ENVIRONMENT=development

# Configuration de débogage
DEBUG=true
LOG_LEVEL=debug

# Notes:
# 1. Créez un fichier .env à partir de ce template
# 2. Remplissez les valeurs avec vos propres clés API
# 3. Ne commitez jamais le fichier .env réel dans Git
# 4. Utilisez .env.example comme template pour les autres développeurs